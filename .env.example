# OpsPilot AI configuration. Copy to .env and fill in the blanks:
#   cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- Application --------------------------------------------------------------
APP_NAME=OpsPilot AI
# development | test | staging | production
APP_ENV=development
# Must be false in production.
APP_DEBUG=true

APP_HOST=0.0.0.0
APP_PORT=8000

# --- Application database -----------------------------------------------------
# OpsPilot's own PostgreSQL database (never your company's business database).
# Used when running the backend directly on your machine. Docker Compose builds
# its own URL from the POSTGRES_* values below and ignores this one.
# Example, with the database from docker-compose.dev.yml:
#   DATABASE_URL=postgresql+psycopg://opspilot:<POSTGRES_PASSWORD>@localhost:5432/opspilot
# Leave empty to run without a database: the app starts and /health/database
# reports "not_configured". Required when APP_ENV=production.
DATABASE_URL=

# Connection pool (one pool per backend process). The defaults suit a single
# installation; raise them only if requests start waiting for connections.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Seconds to wait for a free pooled connection before answering 503.
DATABASE_POOL_TIMEOUT_SECONDS=10
# Seconds after which a pooled connection is replaced.
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# PostgreSQL container credentials (Docker Compose). Use URL-safe characters
# (letters, digits, - _ .) in the password because it is embedded in a URL.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=
POSTGRES_DB=opspilot

# --- Test database (backend tests only) -----------------------------------------
# A SEPARATE, disposable database for `pytest`. The tests drop and recreate its
# tables, so it must never be your real database: its name must contain "test"
# and it must differ from DATABASE_URL, or pytest refuses to run.
# Start one with: docker compose -f docker-compose.test.yml up -d
# and use (these values match docker-compose.test.yml's defaults):
#   TEST_DATABASE_URL=postgresql+psycopg://opspilot_test:opspilot_test@localhost:55432/opspilot_test
# Leave empty to skip the PostgreSQL tests.
TEST_DATABASE_URL=

# --- Browser access -----------------------------------------------------------
# Comma-separated browser origins allowed to call the API. '*' is rejected.
CORS_ORIGINS=http://localhost:5173

# --- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Security -----------------------------------------------------------------
# Signs access tokens. At least 32 characters. Required when APP_ENV=production
# (strongly recommended everywhere). Changing it signs everyone out of their
# current access token only (sessions survive). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Authentication -------------------------------------------------------------
# Access tokens are short-lived JWTs signed with SECRET_KEY and held in browser
# memory. Without SECRET_KEY (development only) a temporary key is generated at
# each start, which simply makes browsers refresh their access token.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh tokens rotate on every use and live in an HttpOnly cookie. A session
# ends after REFRESH_TOKEN_EXPIRE_DAYS without use, and after
# SESSION_ABSOLUTE_MAX_DAYS in any case.
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_ABSOLUTE_MAX_DAYS=30
# Empty = Secure cookies everywhere except APP_ENV=development/test (plain
# http://localhost). Production requires HTTPS and refuses false.
AUTH_COOKIE_SECURE=
# strict (default) or lax. The frontend and backend must be on the same site
# (e.g. localhost:5173 and localhost:8000, or app.example.com and api.example.com).
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_DOMAIN=
# Show IP address and browser on sessions to administrators.
AUTH_RECORD_CLIENT_METADATA=true

# Password reset. There is no email delivery yet: administrators create one-time
# reset links from the Users page. Links point at FRONTEND_BASE_URL (default:
# the first CORS origin).
FRONTEND_BASE_URL=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_ADMIN_LINKS_ENABLED=true

# Brute-force protection: after LOGIN_MAX_FAILED_ATTEMPTS consecutive failures
# the account is locked for LOGIN_LOCKOUT_BASE_SECONDS, doubling per further
# failure up to LOGIN_LOCKOUT_MAX_SECONDS. Locks always expire on their own.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=900
# Rate limits per AUTH_RATE_LIMIT_WINDOW_SECONDS (in memory, per backend process).
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_PER_IP=30
AUTH_RATE_LIMIT_PER_ACCOUNT=10
AUTH_REFRESH_RATE_LIMIT_PER_IP=300

# --- Permission engine (Module 04) --------------------------------------------
# Deepest AND/OR nesting allowed in a permission's row filters, and the most
# conditions one permission policy may contain.
AUTHORIZATION_POLICY_MAX_DEPTH=4
AUTHORIZATION_POLICY_MAX_CONDITIONS=50
# Users whose resolved permissions are cached per backend process (0 disables).
# The cache is checked against a database revision on every decision, so it is
# never stale; it only saves the role/permission join queries.
AUTHORIZATION_CACHE_SIZE=1024

# --- Schema registry (Module 06) ----------------------------------------------
# Imported schema metadata is treated as untrusted input. Largest import request
# body (bytes), deepest JSON nesting, and the most tables, columns per table and
# relationships one schema source may hold.
SCHEMA_IMPORT_MAX_BYTES=5242880
SCHEMA_IMPORT_MAX_DEPTH=10
SCHEMA_MAX_TABLES=2000
SCHEMA_MAX_COLUMNS_PER_TABLE=1000
SCHEMA_MAX_RELATIONSHIPS=5000

# --- Company API connector (Module 07) ----------------------------------------
# OpsPilot never connects to your business database. It calls ONE company HTTPS
# GET endpoint that runs SQL for it (see docs/CONNECTORS.md).
#
# REQUIRED to create or test a connector: a dedicated AES-256 key that encrypts
# the connector's API key / token and secret headers in OpsPilot's database. It
# must be 32 random bytes, base64url-encoded, and must NOT be SECRET_KEY.
# Without it the app still starts, but connectors cannot be saved or used (the
# app never falls back to storing credentials in plaintext).
# Generate one (PowerShell, cmd, macOS or Linux, any Python 3):
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# No Python on Windows? Use the backend image after `docker compose build`:
#   docker compose run --rm --no-deps backend python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep a copy somewhere safe (a password manager). Losing it means re-entering
# every connector credential.
CONNECTOR_ENCRYPTION_KEY=
# Key rotation: put the OLD key here (comma-separated if several), set a new
# CONNECTOR_ENCRYPTION_KEY, restart, then run
#   docker compose exec backend python -m app.cli rotate-connector-keys
# and finally empty this value and restart again.
CONNECTOR_ENCRYPTION_PREVIOUS_KEYS=

# REQUIRED: hosts the connector may call. Nothing is allowed until you list it.
# Comma-separated exact host names, or *.example.com for any subdomain.
#   CONNECTOR_ALLOWED_HOSTS=company-backend.example.com
CONNECTOR_ALLOWED_HOSTS=
# Private address ranges (CIDR) the connector may reach. Private, loopback and
# link-local addresses are blocked by default to prevent SSRF. Approve only the
# network where your company API actually lives, e.g. 10.20.0.0/16.
# Docker Desktop on Windows/macOS: to call an API running on your own PC, use
# http(s)://host.docker.internal:<port> as the Base URL; it resolves to a
# private Docker address (usually 192.168.65.0/24), which you must approve here.
# Link-local (169.254.x.x, cloud metadata) is never allowed.
CONNECTOR_ALLOWED_PRIVATE_NETWORKS=
# Allow plain http:// URLs. Honoured only when APP_ENV=development or test, and
# refused at startup in production. Leave false unless testing a local API.
CONNECTOR_ALLOW_HTTP=false
# Optional path (inside the container) to extra CA certificates (PEM) if your
# company API uses an internal certificate authority. TLS is always verified.
CONNECTOR_CA_BUNDLE=
# Hard limits that per-connector settings can never exceed.
# Longest request URL (bytes). SQL travels in the URL, and longer queries are
# rejected rather than truncated. Match it to your API's server/proxy limit.
CONNECTOR_MAX_URL_LENGTH=8192
CONNECTOR_MAX_RESPONSE_BYTES_LIMIT=52428800
CONNECTOR_MAX_TIMEOUT_SECONDS=120
# Shared outbound HTTP connection pool (per backend process).
CONNECTOR_POOL_MAX_CONNECTIONS=20
CONNECTOR_POOL_MAX_KEEPALIVE=10

# The first administrator is NOT configured here: create it once with
#   docker compose exec backend python -m app.cli create-admin
# (see README, "First administrator"). No default account exists.

# --- AI provider (Module 08) -------------------------------------------------
# Optional. With no API key/model the application still starts; the AI provider
# page simply shows "Not configured". See docs/AI_PROVIDERS.md.
# The key stays on the server: it is never stored in the database, never sent
# to the browser and never logged. After changing these values restart the
# backend:  docker compose up -d backend
#
# Which provider the application uses: nvidia (default) or openai_compatible.
AI_PROVIDER=nvidia
#
# NVIDIA API. Create a key at https://build.nvidia.com (it starts with "nvapi-").
# Paste it without quotes or spaces.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# The model id exactly as NVIDIA lists it, e.g. meta/llama-3.1-70b-instruct
NVIDIA_MODEL=
#
# Any other OpenAI-compatible endpoint (only used with AI_PROVIDER=openai_compatible).
# Base URL up to and including /v1. https:// required in production.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
#
# Generation defaults. Requests may lower AI_MAX_OUTPUT_TOKENS, never raise it.
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=1024
# Seconds one provider request may take.
AI_REQUEST_TIMEOUT_SECONDS=60
# Extra attempts for transient failures only (connection refused, HTTP 429/502/503).
# Authentication errors and timeouts after sending are never retried. 0 disables retries.
AI_MAX_RETRIES=2
# Longest wait between attempts (also caps the provider's Retry-After).
AI_RETRY_MAX_WAIT_SECONDS=20
# "Run test" clicks allowed per administrator per 5 minutes (each spends a few tokens).
AI_TEST_RATE_LIMIT_PER_USER=10
# Ask the provider for JSON output ({"type": "json_object"}) on structured requests.
# Leave false unless your model supports it; the backend validates the JSON either way.
AI_JSON_RESPONSE_FORMAT=false

# --- Question understanding (Module 09) ----------------------------------------
# IANA timezone used to resolve "yesterday", "last month" and similar. An
# administrator can override it from the browser (application setting
# business.timezone); this is the fallback. Default: UTC.
BUSINESS_TIMEZONE=UTC
# Interpretation requests (understand + preview) per user per minute.
AI_UNDERSTAND_RATE_LIMIT_PER_USER=20
# Most permitted tables sent to the model for one question (larger schemas are
# narrowed by keyword relevance).
AI_UNDERSTAND_MAX_SCHEMA_TABLES=12
# Extra model requests allowed to correct invalid output (0 to 3).
AI_UNDERSTAND_MAX_CORRECTIONS=1
# Output token ceiling for one interpretation.
AI_UNDERSTAND_MAX_OUTPUT_TOKENS=1500

# --- SQL generation (Module 10) -------------------------------------------------
# Generated SQL is untrusted: it is stored and shown, never executed by this module.
# Generation requests (generate + regenerate) per user per minute.
AI_SQL_RATE_LIMIT_PER_USER=10
# Extra model requests when generated SQL fails preliminary validation (0 to 3).
AI_SQL_MAX_REGENERATIONS=2
# Manual "Regenerate SQL" requests allowed per interpreted question.
AI_SQL_MAX_MANUAL_REGENERATIONS=3
# Output token ceiling for one SQL generation request.
AI_SQL_MAX_OUTPUT_TOKENS=1500
# Most tables sent as SQL context (the question's tables plus join paths).
AI_SQL_MAX_SCHEMA_TABLES=8
# Largest row limit a generated query may use; detail queries must always be limited.
AI_SQL_MAX_ROW_LIMIT=1000
# Minutes an interpreted question may be used for SQL generation (relative dates age).
AI_SQL_INTENT_MAX_AGE_MINUTES=60

# --- SQL security guard (Module 11) ---------------------------------------------
# Every generated query is re-checked here before it may reach a connector. See docs/SQL_SECURITY.md.
# Validation requests per user per minute.
AI_SQL_VALIDATION_RATE_LIMIT_PER_USER=30
# Seconds an execution approval stays usable (single use, bound to the exact SQL).
AI_SQL_APPROVAL_TTL_SECONDS=300
# Longest SQL text the guard will parse.
AI_SQL_GUARD_MAX_SQL_LENGTH=20000
# Complexity limits (queries above any limit are rejected, never trimmed).
AI_SQL_GUARD_MAX_JOINS=6
AI_SQL_GUARD_MAX_TABLES=8
AI_SQL_GUARD_MAX_NESTING_DEPTH=3
AI_SQL_GUARD_MAX_CTES=5
AI_SQL_GUARD_MAX_SUBQUERIES=6
AI_SQL_GUARD_MAX_EXPRESSIONS=600
# Most rows an approved query may return; a LIMIT is added when missing.
AI_SQL_GUARD_MAX_RESULT_ROWS=1000
# Timeout the company API must apply (passed with the approval; the guard cannot enforce it remotely).
AI_SQL_GUARD_MAX_EXECUTION_SECONDS=30
# Off by default; turn on only if your company API is sized for them.
AI_SQL_GUARD_ALLOW_WINDOW_FUNCTIONS=false
AI_SQL_GUARD_ALLOW_SET_OPERATIONS=false
# Allow one query to read from more than one database schema.
AI_SQL_GUARD_ALLOW_CROSS_SCHEMA=false
# Comma-separated schema namespaces the guard accepts (empty = every registered namespace).
AI_SQL_GUARD_ALLOWED_NAMESPACES=
# Extra allowed functions, comma-separated as dialect:function (e.g. postgres:date_part).
AI_SQL_GUARD_EXTRA_FUNCTIONS=
# Extra approved joins beyond registered relationships, comma-separated as schema.table.column=schema.table.column.
AI_SQL_GUARD_APPROVED_JOINS=

# --- Frontend -----------------------------------------------------------------
# Backend URL as seen from the browser. Built into the frontend bundle, so it
# must never contain a secret.
VITE_API_BASE_URL=http://localhost:8000
# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000
