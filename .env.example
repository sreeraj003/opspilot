# OpsPilot AI configuration. Copy to .env and fill in the blanks:
#   cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- Application --------------------------------------------------------------
APP_NAME=OpsPilot AI
# development | test | staging | production
APP_ENV=development
# Must be false in production.
APP_DEBUG=true

APP_HOST=0.0.0.0
APP_PORT=8000

# --- Application database -----------------------------------------------------
# OpsPilot's own PostgreSQL database (never your company's business database).
# Used when running the backend directly on your machine. Docker Compose builds
# its own URL from the POSTGRES_* values below and ignores this one.
# Example, with the database from docker-compose.dev.yml:
#   DATABASE_URL=postgresql+psycopg://opspilot:<POSTGRES_PASSWORD>@localhost:5432/opspilot
# Leave empty to run without a database: the app starts and /health/database
# reports "not_configured". Required when APP_ENV=production.
DATABASE_URL=

# PostgreSQL container credentials (Docker Compose). Use URL-safe characters
# (letters, digits, - _ .) in the password because it is embedded in a URL.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=
POSTGRES_DB=opspilot

# --- Browser access -----------------------------------------------------------
# Comma-separated browser origins allowed to call the API. '*' is rejected.
CORS_ORIGINS=http://localhost:5173

# --- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Security -----------------------------------------------------------------
# At least 32 characters. Required when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- AI provider (optional until the LLM module) ------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# --- Frontend -----------------------------------------------------------------
# Backend URL as seen from the browser. Built into the frontend bundle, so it
# must never contain a secret.
VITE_API_BASE_URL=http://localhost:8000
# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000
