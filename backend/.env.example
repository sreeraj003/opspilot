# Copy to .env and adjust. Never commit .env.

# Application
APP_NAME="OpsPilot AI API"
APP_VERSION=0.1.0
ENVIRONMENT=development        # development | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                # json | console

# CORS: comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. Required for authentication and every data endpoint (they return 503
# without it). Leave empty only to run the health endpoints; readiness then
# reports the database check as "not_configured". Apply migrations with
# `alembic upgrade head`.
# Example: postgresql+psycopg://opspilot:change-me@localhost:5432/opspilot
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Authentication
# Required in staging/production (at least 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# When empty in development/test, a random key is generated at startup and all
# tokens become invalid on restart.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_ISSUER=opspilot-api
JWT_AUDIENCE=opspilot
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14   # absolute session lifetime; rotation never extends it
REFRESH_COOKIE_NAME=opspilot_refresh_token
REFRESH_COOKIE_SECURE=true     # set false only for plain-http local development
ALLOW_PUBLIC_REGISTRATION=true # self-service sign-up creates a new organization
PASSWORD_MIN_LENGTH=12

# Argon2id password hashing cost
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Login rate limiting (in-process; per client IP and per account)
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
